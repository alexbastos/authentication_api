{
  "name": "authentication-api",
  "version": "1.0.0",
  "description": "Centralized Identity Provider (IdP) microservice with Clean Architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node scripts/generate-version.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "test": "vitest run",
    "test:unit": "vitest run --dir src/domain src/application",
    "test:integration": "vitest run --dir src/__tests__",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "keys:generate": "bash scripts/generate-keys.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "authentication",
    "idp",
    "oauth2",
    "oidc",
    "jwt",
    "fastify",
    "clean-architecture"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-ses": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.6.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.8.2",
    "@sinclair/typebox": "^0.34.33",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.3",
    "geoip-lite": "^2.0.3",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "otpauth": "^9.5.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "uuid": "^11.1.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.15.18",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "overrides": {
    "fast-uri@^3.0.0": "3.1.6",
    "fast-uri@^4.0.0": "4.1.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
