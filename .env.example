# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db?schema=public

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT (RS256) ───────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
JWT_ISSUER=authentication-api

# ─── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ─── Bcrypt ────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Application & Email ───────────────────────────────────────────────────
# APP_URL = URL do FRONTEND (usada nos links dos e-mails). NÃO é a URL da API.
APP_URL=http://localhost:3001
VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# ─── Email / AWS SES ──────────────────────────────────────────────────────
# Use 'console' for dev (logs to terminal), 'ses' for production (AWS SES)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=your-verified-email@domain.com
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
# Set to LocalStack URL for dev, omit in production (uses default AWS endpoint)
AWS_ENDPOINT_URL=http://localhost:4566

# ─── Brute Force Protection ────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
